        "# Stores the scores in one variable which is known as an array\n",
        "scores = [97, 98, 99, 100]\n",
        "\n",
        "# Displays the scores stored inside the variable \"scores\"\n",
        "def display_scores():\n",
        "  print(\"\")\n",
        "  print(\"Scores:\")\n",
        "  for i in range(len(scores)):\n",
        "    print(f\"Index {i}: {scores[i]}\")\n",
        "\n",
        "# Prompts the user for a score and tries locating it inside the array\n",
        "# If not located, will display a message\n",
        "def search_score():\n",
        "    target = int(input(\"Enter score to search: \"))\n",
        "    if target in scores:\n",
        "        index = scores.index(target)\n",
        "        print(\"Score found at index\", index)\n",
        "    else:\n",
        "        print(\"Score not found.\")\n",
        "\n",
        "# Displays the average of the scores stored inside the array\n",
        "def compute_average():\n",
        "    average = sum(scores) / len(scores)\n",
        "    print(\"Average Score:\", average)\n",
        "\n",
        "# Asks the user what score to update via index\n",
        "# Then, prompts the user for a new score\n",
        "def update_score():\n",
        "    index = int(input(\"Enter index to update (0-3): \"))\n",
        "    new_score = int(input(\"Enter new score: \"))\n",
        "    scores[index] = new_score\n",
        "    print(\"Score updated!\")\n",
        "\n",
        "# Displays a labeled menu with operations the user can choose from\n",
        "def menu():\n",
        "  while True:\n",
        "    print(\"\")\n",
        "    print(\"=== Student Score Analyzer ===\")\n",
        "    print(\"\")\n",
        "    print(\"Select the number of the operation you want to perform:\")\n",
        "    print(\"\")\n",
        "    print(\"1. Display Scores\")\n",
        "    print(\"2. Search Score\")\n",
        "    print(\"3. Compute Average Score\")\n",
        "    print(\"4. Update Score\")\n",
        "    print(\"5. Display Updated Scores\")\n",
        "    print(\"6. Exit\")\n",
        "    print(\"\")\n",
        "    choice = input(\"Enter your choice: \")\n",
        "\n",
        "    # Calls a function based on the input of the user\n",
        "    if choice == \"1\":\n",
        "        display_scores()\n",
        "    elif choice == \"2\":\n",
        "        search_score()\n",
        "    elif choice == \"3\":\n",
        "        compute_average()\n",
        "    elif choice == \"4\":\n",
        "        update_score()\n",
        "    elif choice == \"5\":\n",
        "        display_scores()\n",
        "    elif choice == \"6\":\n",
        "        print(\"Goodbye!\")\n",
        "        break\n",
        "    else:\n",
        "        print(\"Invalid choice. Try again.\")\n",
        "\n",
        "# Runs the whole program\n",
        "menu()\n",
